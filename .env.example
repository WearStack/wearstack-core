DATABASE_URL=postgresql+psycopg://wearstack:wearstack@localhost:5434/wearstack
ENVIRONMENT=development
LOG_LEVEL=INFO
VITE_API_URL=http://localhost:8010

# Host ports for docker compose (change if they clash with other local services)
DB_PORT=5434
BACKEND_PORT=8010
FRONTEND_PORT=5173

# Auth — set a long random value in any non-dev environment
JWT_SECRET=dev-only-change-me-not-for-production-use
COOKIE_SECURE=false
