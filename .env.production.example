# Copy to .env.production and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me
# Your hostname gives automatic HTTPS. Use ":80" only behind another TLS terminator.
DOMAIN=shop.example.com
COOKIE_SECURE=true
HTTP_PORT=80
HTTPS_PORT=443

# Billing rules: confirm GST_SLAB_BASIS (after_discount | before_discount) with your accountant.
GST_SLAB_BASIS=after_discount
# Discounts above this share of a line need the sale:discount permission.
FREE_DISCOUNT_PERCENT=10
